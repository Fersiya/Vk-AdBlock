{
  "manifest_version": 3,
  "name": "VK Ad Blocker",
  "version": "1.0.0",
  "description": "Блокировщик рекламы для ВКонтакте",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["*://*.vk.com/*", "*://*.vk.ru/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.vk.com/*", "*://*.vk.ru/*"],
      "css": ["blocker.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "vk_ad_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
